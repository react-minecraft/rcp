namespace com.g4vrk.react.inference.model.flower.protocol.schema;

enum DeploymentMode:ubyte { Observe = 0, Enforce = 1, Unknown = 255 }

// Schema version 2 carries the model threshold and enforcement decision.
table FlowerResponse {
  cheat_probability:double;
  schema_version:uint;
  decision_threshold:double = -1.0;
  deployment_mode:DeploymentMode = Unknown;
  enforcement_enabled:bool = false;
  run_id:string;
}
root_type FlowerResponse;
file_identifier "GAFR";
